# Copy this file to .env and fill in your values
DATABASE_URL=sqlite:///mlb.db
# For Postgres: DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/mlb

# Owner accounts must already exist with a password before being allowlisted.
# The first verified login after allowlisting grants the server-owned admin role.
MLBGPT_ADMIN_EMAILS=

# MyDashboard authentication. OAuth callback base is the public backend origin;
# frontend URL is where successful callbacks and password reset links return.
DASHBOARD_FRONTEND_URL=https://mlbgpt.com
DASHBOARD_OAUTH_CALLBACK_BASE_URL=https://your-backend.up.railway.app
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Password reset delivery (works with any standard SMTP provider).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=1
SMTP_USE_SSL=0

# Optional: OpenWeatherMap API key for weather ingestion
OPENWEATHER_API_KEY=your_key_here

# Optional: select odds provider. Leave unset for existing Odds API / DraftKings behavior.
# Set to kibl_bet105 in Railway to use Bet105 as the primary Daily Odds provider.
ODDS_PROVIDER=

# KIBL Bet105 odds provider placeholders only. Never commit real credentials.
KIBL_USERNAME=
KIBL_PASSWORD=
KIBL_COGNITO_REGION=us-west-2
KIBL_COGNITO_CLIENT_ID=3udv7qsqgju8c4riqvk72bqcl
KIBL_BASE_URL=https://api.kibl.io/sports/get
KIBL_ODDS_PATH=
KIBL_FEED_SOURCE_ID=171
KIBL_PREMATCH_BETTING_TYPE_ID=1
KIBL_LIVE_BETTING_TYPE_ID=3
KIBL_TIMEZONE=America/New_York
KIBL_CACHE_TTL_SECONDS=120
KIBL_TIMEOUT_SECONDS=20
KIBL_MARKETS=h2h,spreads,totals
KIBL_PROP_MARKETS=player_props,pitcher_props,batter_props
